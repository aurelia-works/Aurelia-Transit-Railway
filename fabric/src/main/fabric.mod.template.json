{
	"schemaVersion": 1,
	"id": "mtr",
	"version": "@version@",
	"name": "Aurelia Transit Railway",
	"description": "Aurelia Transit Railway: a maintained Minecraft 1.20.1 fork of Minecraft Transit Railway. Drop-in replacement, mod id mtr.",
	"authors": [
		"Aurelia Works",
		"Jonathan Ho (jonafanho), author of Minecraft Transit Railway"
	],
	"contact": {
		"homepage": "https://github.com/aurelia-works/Minecraft-Transit-Railway",
		"sources": "https://github.com/aurelia-works/Minecraft-Transit-Railway",
		"issues": "https://github.com/aurelia-works/Minecraft-Transit-Railway/issues"
	},
	"license": "MIT",
	"custom": {
		"modmenu": {
			"links": {
				"Based on MTR by jonafanho": "https://github.com/Minecraft-Transit-Railway/Minecraft-Transit-Railway"
			}
		}
	},
	"icon": "icon.png",
	"accessWidener": "mtr.accesswidener",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.mtr.init.MTR"
		],
		"client": [
			"org.mtr.init.MTRClient"
		],
		"modmenu": [
			"org.mtr.init.ModMenuConfig"
		],
		"jade": [
			"org.mtr.init.JadeConfig"
		]
	},
	"mixins": [
		"mtr.mixins.json",
		"mtr.models.mixins.json"
	],
	"depends": {
		"fabric": "*",
		"minecraft": "@minecraft@"
	}
}
