{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"javaImplements": [
		"SerializedDataBase"
	],
	"properties": {
		"chatAnnouncements": {
			"type": "boolean",
			"default": true
		},
		"textToSpeechAnnouncements": {
			"type": "boolean",
			"default": true
		},
		"hideTranslucentParts": {
			"type": "boolean"
		},
		"hideRainInsideVehicles": {
			"type": "boolean",
			"default": true
		},
		"languageDisplay": {
			"$ref": "LanguageDisplay"
		},
		"vehicleOscillationMultiplier": {
			"type": "number",
			"default": 1.0
		},
		"dynamicTextureResolution": {
			"type": "integer",
			"default": 2
		},
		"defaultRail3D": {
			"type": "boolean",
			"default": true
		},
		"railLod": {
			"type": "boolean",
			"default": true
		},
		"railSimpleChunks": {
			"type": "integer",
			"default": 3
		},
		"railFarChunks": {
			"type": "integer",
			"default": 8
		},
		"mergeTrainParts": {
			"type": "boolean",
			"default": true
		},
		"trainLod": {
			"type": "boolean",
			"default": true
		},
		"trainInteriorChunks": {
			"type": "integer",
			"default": 5
		},
		"trainBoxChunks": {
			"type": "integer",
			"default": 10
		},
		"useMTRFont": {
			"type": "boolean"
		},
		"disableShadowsForShaders": {
			"type": "boolean"
		},
		"fasterDoorChecks": {
			"type": "boolean",
			"default": true
		},
		"cheapShadows": {
			"type": "boolean",
			"default": true
		},
		"preloadResourcePattern": {
			"type": "string"
		},
		"betaWarningVersion": {
			"type": "string"
		},
		"fasterModelLoading": {
			"type": "boolean",
			"default": true
		},
		"backgroundModelLoading": {
			"type": "boolean",
			"default": true
		},
		"freeUnusedModels": {
			"type": "boolean",
			"default": true
		}
	}
}
